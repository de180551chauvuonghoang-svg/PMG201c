dchain:{label:"Nối từ",blurb:"Nối tiếp từ ghép bằng tiếng cuối của người trước. Bí từ hoặc hết giờ là mất lượt.",style:"party",minPlayers:2,maxPlayers:8},draw:{label:"Vẽ đoán chữ",blurb:"Mỗi lượt một người vẽ, cả phòng đoán. Đoán đúng càng sớm càng nhiều điểm.",style:"party",minPlayers:3,maxPlayers:8},typing:{label:"Đua gõ phím",blurb:"Cùng gõ một đoạn văn, ai gõ đúng và xong sớm nhất thì về nhất.",style:"party",minPlayers:2,maxPlayers:6},xiangqi:{label:"Cờ tướng",blurb:"Cờ tướng 9×10 theo luật chuẩn, mỗi bên có đồng hồ riêng.",style:"duel",minPlayers:2,maxPlayers:2},chess:{label:"Cờ vua",blurb:"Cờ vua luật FIDE, đồng hồ mỗi bên có cộng giây sau mỗi nước.",style:"duel",minPlayers:2,maxPlayers:2},reversi:{label:"Cờ lật",blurb:"Bàn 8×8, kẹp quân đối thủ để lật sang màu mình. Kín bàn, ai nhiều quân hơn thì thắng.",style:"duel",minPlayers:2,maxPlayers:2},battleship:{label:"Bắn tàu",blurb:"Giấu đội tàu trên lưới 10×10 rồi thay phiên bắn. Đánh chìm hết tàu đối thủ trước là thắng.",style:"duel",minPlayers:2,maxPlayers:2},blocks:{label:"Xếp gạch",blurb:"Mỗi người một bảng gạch rơi. Xếp kín hàng để xoá và đẩy hàng rác sang đối thủ, ai đầy bảng trước thì thua.",style:"duel",minPlayers:2,maxPlayers:2}},n=e=>Object.fromEntries(a.map(t=>[t,e(s[t])])),i=n(e=>e.label);n(e=>1e3*("duel"===e.style));let l=n(e=>"duel"===e.style?"Elo":"Điểm");e.s(["j",0,15,"I",0,5,"k",0,10,"R",0,2,"y",0,6e4,"U",0,4102,"V",0,"Mini games đã tạm đóng","r",0,a,"v",0,i,"J",0,s,"Z",0,l,"S",0,3e4,"s",0,t,"l",0,e=>a.includes(e)])},505071,e=>{"use strict";e.s(["p",0,"MEMBERSHIP_PRICE_CHANGED","N",0,{PURCHASE:"Mua gói",CONTRIBUTION:"Tặng người đóng góp",ADMIN:"Quản trị viên tặng",LEGACY:"Chuyển từ hệ thống cũ",PROMO:"Ưu đãi trong thư"},"k",0,["MEMBER","VIP","NOVA"],"i",0,{NONE:0,MEMBER:1,VIP:2,NOVA:3}])},701890,e=>{"use strict";e.s(["o",0,366,"H",0,[7,30,90],"y",0,{"media-sweep":{label:"Dọn media",description:"Xoá ảnh / tệp mồ côi và tệp của bài đã xoá quá hạn giữ."},"chat-media-expiry":{label:"Tự xoá ảnh / tệp tin nhắn",description:"Mỗi giờ xoá vĩnh viễn ảnh / tệp tin nhắn quá số ngày cài ở Cài đặt › Tin nhắn (kho + CDN); tin nhắn chữ giữ nguyên."},"study-question-images":{label:"Dựng ảnh câu hỏi Học tập",description:"Mỗi 20 giây dựng ảnh (đề bài + phương án, có thuỷ vân) cho vị trí câu chưa có ảnh, câu vừa đổi chữ hoặc vừa bị người học hỏi tới; lượt dựng hàng loạt lần đầu dùng lệnh db:render-question-images."},"cdn-sync":{label:"Đồng bộ CDN R2",description:"Mỗi 10 giây đẩy ảnh công khai đang chờ lên R2 (kiểm từng object), xoá object + purge cache của ảnh đã xoá. CDN tắt → không làm gì."},"account-purge":{label:"Ẩn danh hoá tài khoản",description:"Tài khoản yêu cầu xoá quá hạn chờ → ẩn danh hoá."},"notification-digest":{label:"Email tóm tắt",description:"Gửi email tóm tắt thông báo chưa đọc theo lịch người dùng chọn."},"event-reminders":{label:"Nhắc sự kiện nhóm",description:"Nhắc người tham gia sự kiện bắt đầu trong 60 phút tới."},"login-event-sweep":{label:"Dọn nhật ký đăng nhập",description:"Xoá nhật ký đăng nhập quá 90 ngày."},"wallet-reconcile":{label:"Đối soát ví",description:"Mỗi đêm so số dư từng ví với tổng bút toán — lệch thì báo lỗi (không tự sửa)."},"foryou-pool":{label:"Pool “Dành cho bạn”",description:"Mỗi phút dựng sẵn tập bài ứng viên 72 giờ kèm số đếm vào Redis — request chỉ tính hệ số quan hệ của người xem."},"counters-flush":{label:"Ghi bộ đếm",description:"Ghi lô lượt xem chủ đề và bộ đếm chuyên mục từ Redis xuống DB."},"retention-sweep":{label:"Dọn dữ liệu cũ",description:"Thông báo đã đọc > 90 ngày / chưa đọc > 180 ngày, truy cập học tập > 90 ngày, nhiệm vụ / tín dụng ngày > 30 ngày, tin Tán gẫu > 30 ngày, kết quả AI > 180 ngày."},"counters-reconcile":{label:"Đối soát bộ đếm",description:"Mỗi tuần sửa bộ đếm phi chuẩn hoá bị lệch so với số dòng thật (thành viên nhóm, người theo dõi / đang theo dõi, điểm tín nhiệm)."},"auth-sweep":{label:"Dọn phiên và mã xác minh",description:"Xoá phiên hết hạn / đã thu hồi và mã xác minh đã dùng / hết hạn."},"ai-usage-sweep":{label:"Dọn nhật ký AI",description:"Xoá nhật ký sử dụng AI quá hạn giữ."},"data-export":{label:"Xuất dữ liệu cá nhân",description:"Đóng gói các yêu cầu xuất dữ liệu đang chờ, xoá bản đã hết hạn."},broadcasts:{label:"Thông báo hàng loạt",description:"Gửi các đợt thông báo hàng loạt đang chờ theo lô (thông báo, push, email)."},"study-convert":{label:"Chuyển đổi bộ đề bằng AI",description:"Xử lý các lượt chuyển đổi ảnh / text thành câu hỏi đang chờ; đánh lỗi lượt treo quá hạn."},"payments-reconcile":{label:"Đối soát giao dịch ngân hàng",description:"Mỗi phút gọi API lịch sử giao dịch của nhà cung cấp đang dùng (Web2M / SePay — khi bật ở Tích hợp › Thanh toán) và đưa giao dịch tiền vào mà webhook bị lỡ vào đúng đường xử lý nạp ví."},"payments-expire":{label:"Hết hạn đơn nạp & gói thành viên",description:"Đánh dấu đơn nạp quá 30 phút là hết hạn; cập nhật gói hiệu lực của người vừa hết hạn gói."},"check-score":{label:"Tra điểm EOS",description:"Mỗi 2 phút hỏi dịch vụ chấm H91 các bài người dùng đã đóng tab khi còn trong hàng đợi: có kết quả thì trừ ví / dùng lượt miễn phí / chờ xác nhận giá; không chấm được thì huỷ và tự hoàn tiền nếu đã trừ."},"paper-sync":{label:"Paper Sync",description:"Mỗi 30 giây: tới chu kỳ (hoặc vừa bấm Đồng bộ ngay) thì lấy đề EOS / PEA mới từ API nguồn và tải tệp nguồn về vùng private; đăng các đề đang chờ đăng thành chủ đề diễn đàn. Đồng bộ tắt (mặc định) thì chỉ còn đăng đề admin đã xếp hàng."},coursera:{label:"Coursera",description:"Gửi tài khoản Coursera đang chờ sang hệ thống chạy tự động, đồng bộ trạng thái, hoàn tiền tài khoản lỗi."},courses:{label:"Khoá học",description:"Cộng thu nhập giảng viên hết hạn giữ tiền vào ví; đối soát video Bunny treo đang tải / đang mã hoá."},"study-reminder":{label:"Nhắc giữ chuỗi học",description:"Từ 20:00 (giờ VN) nhắc người đang có chuỗi học mà hôm nay chưa đạt mục tiêu — mỗi người tối đa một lần / ngày."},"leaderboard-rebuild":{label:"Dựng lại bảng xếp hạng",description:"Tính lại bảng xếp hạng mọi thời gian / kỳ này / tuần này từ sổ điểm vào Redis (sửa lệch nếu có)."},"term-close":{label:"Chốt kỳ học",description:"Kỳ liền trước chưa chốt → trao danh hiệu Top 1 / 3 / 10 mỗi nhóm và khung avatar theo kỳ, báo người lọt top."},"frame-expiry":{label:"Gỡ khung avatar hết hạn",description:"Xoá khung avatar có hạn đã quá hạn và gỡ khỏi người đang đeo."},"badge-sync":{label:"Cấp danh hiệu theo lời giải",description:"Người vừa bình luận ảnh ở chuyên mục Môn học (3 giờ gần đây) đủ mốc Cóc Đồng / Bạc / Vàng, Học Bá, Học Thần, Chuyên … → cấp danh hiệu + báo."},"ai-review-sweep":{label:"Quét bù AI kiểm duyệt",description:"Đưa lại vào hàng đợi AI các nội dung có báo cáo đang mở (7 ngày gần đây) mà chưa có kết quả AI."},"grading-lease":{label:"Lease máy chấm",description:"Bài đang chấm quá hạn lease (máy chấm chết) → về hàng đợi, quá 2 lần → lỗi máy chấm và trả lại lượt."},"grading-ai":{label:"Chấm bài viết bằng AI",description:"Nhặt bài viết đang chờ (mỗi 5 giây hoặc ngay khi có bài), chấm theo rubric qua AI; lỗi AI / hết ngân sách → báo lỗi và trả lại lượt."},"grading-retention":{label:"Dọn bài nộp chấm tự động",description:"Xoá bài nộp quá hạn giữ (mặc định 60 ngày) — giữ bài đang là điểm tốt nhất và bài có khiếu nại mở."},"app-activity-sweep":{label:"Dọn nhật ký app Suộc",description:"Xoá nhật ký request của app FUO Suộc quá 90 ngày và mã đăng nhập một lần đã hết hạn."},"app-suspicious":{label:"Hành vi đáng ngờ app Suộc",description:"Mỗi 10 phút chạy 3 luật của hệ cũ trên nhật ký app (nhiều máy cùng lúc, đổi máy nhiều lần trong ngày, gọi API sau khi phiên đã đăng xuất) → cảnh báo cho admin + cộng điểm nghi ngờ Học tập."},sitemap:{label:"Dựng sitemap",description:"Mỗi ngày một lần (sau 04:00 giờ VN) dựng sẵn mọi tệp sitemap vào bảng SitemapFile — lần lượt từng loại, loại lỗi giữ bản cũ; web và bot chỉ đọc bản dựng sẵn. Bấm Chạy ngay để dựng lại tức thì."},"mail-queue-enqueue":{label:"Xếp hàng thư nhắc hạn gói",description:"Mỗi giờ (khi hàng chờ thư đang bật, trong khung giờ gửi) xếp thư “Gói sắp hết hạn” (còn ≤ 3 ngày) và “Gói đã hết hạn” (hết 2–4 ngày, chưa gia hạn); mỗi người một thư cho mỗi ngày hết hạn."},"mail-queue-send":{label:"Gửi thư trong hàng chờ",description:"Mỗi 10 giây xét gửi MỘT thư theo nhịp, khung giờ và trần 24 giờ ở Quản trị › Thư tự động; lỗi liên tiếp hoặc lỗi hạn mức → tự tạm dừng và báo Telegram."},"referral-revoke":{label:"Thu hồi thưởng giới thiệu",description:"Mỗi giờ: lượt thưởng giới thiệu trong 7 ngày gần nhất mà người được mời bị cấm hoặc gói đầu bị thu hồi (hoàn tiền) → thu hồi ngày thưởng của cả hai."},"study-access":{label:"Tổng hợp truy cập Học tập",description:"Đổ số liệu xem đề (Redis) xuống bảng ngày, chấm điểm nghi ngờ, cập nhật danh sách theo dõi chống crawl."}}])}]);